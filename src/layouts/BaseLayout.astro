---
import { Font } from "astro:assets";
import Footer from "@components/Footer.astro";

const {
  title = "Léo Mercier — 2026",
  description  = "The portfolio of Léo Mercier."
} = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <meta name="author" content="Léo Mercier" />
    <meta name="copyright" content="CC BY-NC-SA" />

    <link rel="canonical" href={Astro.url} />
    <meta name="referrer" content="strict-origin">
    <meta http-equiv="X-Content-Type-Options" content="nosniff">

    <link rel="preconnect" href="/" />

    <Font cssVariable="--font-univers-next" preload />

    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Léo Mercier's portfolio" />

    <meta name="color-scheme" content="light">
    <meta name="theme-color" content="white" />

    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <meta name="robots" content="follow, index, max-snippet:-1, max-video-preview:-1, max-image-preview:large" />

    <meta property="og:site_name" content="Léo Mercier's portfolio" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    <title>{title}</title>
  </head>
  <body class="antialiased min-h-screen overflow-x-hidden scroll-smooth font-sans bg-white text-zinc-500 **:outline-none **:focus-visible:ring-2 **:focus-visible:ring-zinc-400 selection:bg-zinc-900 selection:text-white">
    <slot />
    <Footer />
  </body>
</html>

<style is:global>
  @import "tailwindcss";

  @theme inline {
    --font-sans: var(--font-univers-next);
  }
</style>
