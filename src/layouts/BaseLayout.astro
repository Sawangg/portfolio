---
import { Font } from "astro:assets";
import Footer from "@components/Footer.astro";

const { title, description } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <meta
      name="description"
      property="og:description"
      content={description ?? "The 2025 portfolio of Léo Mercier."}
    />

    <meta name="author" content="Léo Mercier" />
    <meta name="copyright" content="CC BY-NC-SA" />

    <link rel="canonical" href={Astro.url} />
    <meta name="referrer" content="strict-origin">
    <meta http-equiv="X-Content-Type-Options" content="nosniff">

    <link rel="preconnect" href="/" />

    <Font cssVariable="--font-univers-next" preload />

    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Léo Mercier's portfolio" />

    <meta name="color-scheme" content="light dark">
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="white" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="white" />

    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <meta name="robots" content="follow, index, max-snippet:-1, max-video-preview:-1, max-image-preview:large" />

    <meta property="og:site_name" content="Léo Mercier's portfolio" />
    <meta property="og:title" content={title ?? "Léo Mercier's portfolio"} />
    <meta property="og:type" content="website" />

    <title>{title ?? "Léo Mercier — 2026"}</title>
  </head>
  <body class="scheme-light antialiased min-h-screen overflow-x-hidden scroll-smooth font-sans bg-white text-zinc-500 transition-colors ease-in-out duration-300 **:outline-none **:focus:ring-2 **:focus:ring-sky-500 selection:bg-sky-500 selection:text-white">
    <slot />
    <Footer />
  </body>
</html>

<style is:global>
  @import "tailwindcss";

  @theme inline {
    --font-sans: var(--font-univers-next);
  }
</style>


