---
import BaseLayout from "@components/BaseLayout.astro";
---

<BaseLayout title="Léo Mercier — Projects">
  <main class="flex flex-col px-4 gap-y-10 mt-10 mx-auto max-w-250 text-[1.1rem]/7 sm:px-0">
    <div class="mx-auto flex flex-col gap-y-5 text-center">
      <h1 class="font-semibold text-black dark:text-white text-4xl ">Projects</h1>
      <p class="italic">Here is the list of projects I've worked on</p>
      <hr class="my-4 w-1/3 self-center text-black/20 dark:text-white/30" />
    </div>
    <div class="grid sm:grid-cols-1 px-6 gap-x-7 **:p-2 **:rounded-lg sm:grid-cols-3 md:gap-x-10 lg:px-0">
      <a href="https://github.com/Sawangg/dotfiles" target="_blank">
        <p>Artix Dotfiles</p>
        <p class="text-sm opacity-50">My custom Linux devlopment environment</p>
      </a>
      <a href="https://github.com/Sawangg/heraUI" target="_blank">
        <p>HeraUI</p>
        <p class="text-sm opacity-50">Copy paste UI using react-aria-components</p>
      </a>
      <a href="https://github.com/Sawangg/kronos" target="_blank">
        <p>Kronos</p>
        <p class="text-sm opacity-50">Financial backtesting engine in Rust</p>
      </a>
      <a href="https://github.com/Sawangg/adventurit" target="_blank">
        <p>Adventur'IT</p>
        <p class="text-sm opacity-50">Recruiting platform for Société Générale</p>
      </a>
    </div>
  </main>
</BaseLayout>
