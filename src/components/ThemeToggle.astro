---
import Moon from "@assets/images/moon.svg";
import Sun from "@assets/images/sun.svg";
---

<theme-toggle tabindex="0" class="cursor-pointer focus:ring-1">
  <Moon class="size-5 hidden dark:block" />
  <Sun class="size-5 dark:hidden" />
</theme-toggle>

<script>
  customElements.define(
    "theme-toggle",
    class extends HTMLElement {
      connectedCallback() {
        this.addEventListener("click", () => {
          window.theme.getTheme() === "dark" ? window.theme.setTheme("light") : window.theme.setTheme("dark");
        });
      }
    }
  );
</script>
