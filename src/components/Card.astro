---
const props = Astro.props;
---

<article class={`p-8 w-full rounded-[2rem] ${props.class}`}>
  <h3 class="font-bold text-xl">{props.company}</h3>
  <p class="mb-2 text-md">
    <time datetime=`${props.date[0]}-01-01T00:00:00`>{props.date[0]}</time>
    {props.date[1] && " - "}
    {!isNaN(Date.parse(props.date[1])) ?
      <time datetime=`${props.date[1]}-01-01T00:00:00`>{props.date[1]}</time>
      : <span>{props.date[1]}</span>
    }
  </p>
  <hr class="mb-4 rounded border border-zinc-950/10" />
  {props.title && <h4 class="mb-2 font-semibold">{props.title}</h4>}
  <p class="font-normal">{props.description}</p>
  {props.link && <span>t</span>}
</article>
