    <div class="grid gap-12 md:grid-cols-2">
      <article class="project-card group">
        <div class="aspect-video bg-zinc-100 rounded-xl mb-6 flex items-center justify-center overflow-hidden">
          <div class="text-zinc-300 text-6xl font-bold select-none group-hover:scale-105 transition-transform duration-500">01</div>
        </div>
        <span class="text-xs tracking-widest uppercase text-zinc-400">Kubernetes &middot; Terraform</span>
