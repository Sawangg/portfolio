<section class="py-32 px-6" id="work">
  <div class="max-w-5xl mx-auto">
    <h2 class="text-4xl sm:text-5xl font-bold tracking-tight text-zinc-900 mb-20">Recent work</h2>

    <div class="space-y-16">

      <work-entry class="block">
        <div class="mb-1">
          <h3 class="text-xl font-bold text-zinc-900">Crédit Agricole CIB</h3>
          <p class="text-sm text-zinc-400">Nov 2024 – Present</p>
        </div>
        <hr class="border-zinc-200 my-4" />
        <p class="font-semibold text-zinc-800 mb-2">Site Reliability Engineer</p>
        <p class="text-zinc-500 leading-relaxed max-w-2xl">
        I architect and operate the full AWS infrastructure for the bank's regulatory department, ensuring 100% availability of critical financial applications. I built end-to-end CI/CD pipelines and Kubernetes automation that cut deployment times by two third, and mentor incoming DevOps engineers on infrastructure and on-call practices.
        </p>
      </work-entry>

      <div class="grid gap-16 md:grid-cols-2">

        <work-entry class="block">
          <div class="mb-1">
            <h3 class="text-xl font-bold text-zinc-900">BPCE</h3>
            <p class="text-sm text-zinc-400">Mar 2022 – Nov 2024</p>
          </div>
          <hr class="border-zinc-200 my-4" />
          <p class="font-semibold text-zinc-800 mb-2">Software Engineer</p>
          <p class="text-zinc-500 leading-relaxed">
            I led the design and rollout of an AI coding assistant that boosted productivity for over 5,000 developers, built an on-boarding platform deployed across a dozen countries that halved ramp-up time, and maintained 99.9% uptime across all on-premise products.
          </p>
        </work-entry>

        <work-entry class="block">
          <div class="mb-1">
            <h3 class="text-xl font-bold text-zinc-900">Natixis</h3>
            <p class="text-sm text-zinc-400">Sep 2021 – Mar 2022</p>
          </div>
