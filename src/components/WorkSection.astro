          <p class="text-zinc-500 leading-relaxed">
            I built an audio recording platform that collected voice data from 10,000 employees to train in-house AI models, reduced codebase size by 50% through a shared services library, and launched a showroom site that secured three new contracts.
          </p>
        </work-entry>

      </div>

    </div>
  </div>
</section>

<script>
  const entries = document.querySelectorAll("work-entry");

  const observer = new IntersectionObserver(
    (observed) => {
      observed.forEach((entry) => {
        if (entry.isIntersecting) {
          (entry.target as HTMLElement).style.opacity = "1";
          (entry.target as HTMLElement).style.transform = "translateY(0)";
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1, rootMargin: "0px 0px -40px 0px" },
  );

  entries.forEach((entry, i) => {
    const el = entry as HTMLElement;
    el.style.opacity = "0";
    el.style.transform = "translateY(28px)";
    el.style.transition = `opacity 0.6s ease ${i * 0.1}s, transform 0.6s ease ${i * 0.1}s`;
    observer.observe(el);
  });
</script>
