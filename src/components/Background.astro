<canvas id="dots" class="fixed top-0 left-0 w-screen h-screen -z-10"></canvas>

<script>
  class PerlinNoise {
    private permutation: number[] = [];
    private gradX: number[] = [];
    private gradY: number[] = [];

    constructor() {
      this.init();
    }

    private init(): void {
      const p: number[] = Array.from({ length: 256 }, (_, i) => i);

      for (let i = 0; i < 256; i++) {
        const r = Math.floor(Math.random() * 256);
        [p[i]!, p[r]!] = [p[r]!, p[i]!];
      }

      this.permutation = p.concat(p);

      const gx: number[] = [];
      const gy: number[] = [];
      for (let i = 0; i < 256; i++) {
        const angle = Math.random() * 2 * Math.PI;
        gx[i] = Math.cos(angle);
        gy[i] = Math.sin(angle);
      }

      this.gradX = gx.concat(gx);
      this.gradY = gy.concat(gy);
    }

    public noise2D(x: number, y: number): number {
      const X = Math.floor(x) & 255;
      const Y = Math.floor(y) & 255;
      const rx = x - Math.floor(x);
      const ry = y - Math.floor(y);

      const aaIndex = (X + this.permutation[Y]!) & 511;
      const abIndex = (X + this.permutation[(Y + 1) & 255]!) & 511;
      const baIndex = ((X + 1) + this.permutation[Y]!) & 511;
      const bbIndex = ((X + 1) + this.permutation[(Y + 1) & 255]!) & 511;

      const aa = this.permutation[aaIndex]! & 255;
      const ab = this.permutation[abIndex]! & 255;
      const ba = this.permutation[baIndex]! & 255;
      const bb = this.permutation[bbIndex]! & 255;

      const gradAA = this.gradX[aa]! * rx + this.gradY[aa]! * ry;
      const gradBA = this.gradX[ba]! * (rx - 1) + this.gradY[ba]! * ry;
      const gradAB = this.gradX[ab]! * rx + this.gradY[ab]! * (ry - 1);
      const gradBB = this.gradX[bb]! * (rx - 1) + this.gradY[bb]! * (ry - 1);

      const fade = (t: number) => t * t * t * (t * (t * 6 - 15) + 10);
      const u = fade(rx);
      const v = fade(ry);

      const lerp = (a: number, b: number, t: number) => a + t * (b - a);

      const x1 = lerp(gradAA, gradBA, u);
      const x2 = lerp(gradAB, gradBB, u);
      const val = lerp(x1, x2, v);

      return (val + 1) / 2;
    }
  }

  const canvas = document.getElementById("dots") as HTMLCanvasElement;
  const ctx = canvas.getContext("2d");

  const points: { x: number; y: number; }[] = [];
  const SCALE = 200;
  const LENGTH = 24;
  const SPACING = 15;

  const perlin = new PerlinNoise();

  function resize(): void {
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
    createPoints();
  }

  function createPoints(): void {
    points.length = 0;
    for (let x = 0; x < window.innerWidth + SPACING; x += SPACING) {
      for (let y = 0; y < window.innerHeight + SPACING; y += SPACING) {
        points.push({ x, y });
      }
    }
  }

  function draw(): void {
    if (!ctx) return;
    ctx.clearRect(0, 0, window.innerWidth, window.innerHeight);
    const t = Date.now() / 10000;

    for (const p of points) {
      const rad = (perlin.noise2D(p.x / SCALE, p.y / SCALE + t) - 0.5) * 2 * Math.PI;
      const length = (perlin.noise2D(p.x / SCALE, p.y / SCALE + t * 2) + 0.5) * LENGTH;
      const nx = p.x + Math.cos(rad) * length;
      const ny = p.y + Math.sin(rad) * length;
      const alpha = Math.abs(Math.cos(rad)) * 0.5 + 0.5;
      ctx.beginPath();
      ctx.fillStyle = window.theme.getTheme() === "dark" ? `rgba(120, 120, 120, ${alpha})` : `rgba(180, 180, 180, ${alpha})`;
      ctx.arc(nx, ny, 1, 0, 2 * Math.PI);
      ctx.fill();
    }
    requestAnimationFrame(draw);
  }

  window.addEventListener("resize", resize);
  resize();
  draw();
</script>
