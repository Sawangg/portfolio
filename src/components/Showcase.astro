<section class="relative min-h-[1100vh]" id="showcase-section">
  <div class="sticky top-0 h-screen flex items-center justify-center overflow-hidden bg-white">
    <canvas id="showcase-canvas" class="absolute inset-0 w-full h-full" aria-hidden="true"></canvas>
    <div id="showcase-container" class="absolute inset-0 z-10 pointer-events-none">
      <p class="transition-[opacity,transform] duration-150 ease-in-out pointer-events-none opacity-0 text-3xl sm:text-5xl md:text-7xl lg:text-8xl font-semibold text-zinc-900 leading-tight text-center px-6 absolute inset-0 flex items-center justify-center" data-chapter="0">
        I keep systems running
      </p>
      <p class="transition-[opacity,transform] duration-150 ease-in-out pointer-events-none opacity-0 text-3xl sm:text-5xl md:text-7xl lg:text-8xl font-semibold text-zinc-900 leading-tight text-center px-6 absolute inset-0 flex items-center justify-center" data-chapter="1">
        through late nights and early mornings.
      </p>
      <p class="transition-[opacity,transform] duration-150 ease-in-out pointer-events-none opacity-0 text-3xl sm:text-5xl md:text-7xl lg:text-8xl font-semibold text-zinc-900 leading-tight text-center px-6 absolute inset-0 flex items-center justify-center" data-chapter="2">
        With zero surprises
      </p>
      <p class="transition-[opacity,transform] duration-150 ease-in-out pointer-events-none opacity-0 text-3xl sm:text-5xl md:text-7xl lg:text-8xl font-semibold text-zinc-900 leading-tight text-center px-6 absolute inset-0 flex items-center justify-center" data-chapter="3">
        from commit to production.
      </p>
      <p class="transition-[opacity,transform] duration-150 ease-in-out pointer-events-none opacity-0 text-3xl sm:text-5xl md:text-7xl lg:text-8xl font-semibold text-zinc-900 leading-tight text-center px-6 absolute inset-0 flex items-center justify-center" data-chapter="4">
        And everything in between.
      </p>
    </div>
  </div>
</section>

<script>
  import { createShowcaseScene } from "@lib/showcase/showcaseScene";
  import { observeScrollProgress } from "@lib/scroll";

  const canvas = document.getElementById("showcase-canvas") as HTMLCanvasElement;
  const section = document.getElementById("showcase-section") as HTMLElement;
  const container = canvas?.parentElement as HTMLElement;
  const texts = document.querySelectorAll<HTMLElement>("#showcase-container > p");

  if (canvas && container && section && texts?.length) {
    const scene = createShowcaseScene({ canvas, container });

    function easeInOut(t: number): number {
      return t < 0.5 ? 2 * t * t : 1 - (-2 * t + 2) ** 2 / 2;
    }

    observeScrollProgress(section, (progress) => {
      scene.setScrollProgress(progress);

      const { chapterIndex, chapterProgress, transitionAlpha } = scene.getChapterInfo();

      const textIn = Math.max(0, Math.min(1, (chapterProgress - 0.15) / 0.20));
      const textOut = Math.max(0, Math.min(1, (0.85 - chapterProgress) / 0.20));
      const chapterTextAlpha = easeInOut(textIn) * easeInOut(textOut);

      texts.forEach((el) => {
        const idx = Number(el.dataset.chapter);
        const alpha = idx === chapterIndex ? chapterTextAlpha * transitionAlpha : 0;
        el.style.opacity = String(alpha);
        el.style.transform = `translateY(${(1 - easeInOut(textIn)) * 16}px)`;
      });
    });
  }
</script>
