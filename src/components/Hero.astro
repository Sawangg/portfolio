<section>
  <div class="flex items-start justify-center min-h-screen pt-[28vh] px-6">
    <div class="text-center max-w-4xl">
      <h1 class="text-4xl sm:text-6xl md:text-7xl lg:text-8xl font-bold tracking-tight text-zinc-900 leading-tight">
        <span class="flex flex-wrap justify-center gap-x-[0.3em] overflow-hidden">
          <span class="hero-word opacity-0">Building</span>
          <span class="hero-word opacity-0">systems</span>
        </span>
        <span class="flex flex-wrap justify-center gap-x-[0.3em] overflow-hidden">
          <span class="hero-word opacity-0">that</span>
          <span class="hero-word opacity-0">never</span>
          <span class="hero-word opacity-0">sleep.</span>
        </span>
      </h1>
      <p id="hero-subtitle" class="opacity-0 mt-6 text-lg sm:text-xl text-zinc-400 max-w-xl mx-auto">
        Site Reliability Engineer & DevOps
      </p>
    </div>
  </div>
</section>

<script>
  const words = document.querySelectorAll<HTMLElement>(".hero-word");
  const subtitle = document.getElementById("hero-subtitle");

  const WORD_DURATION_MS = 550;
  const WORD_STAGGER_MS  = 80;
  const SUBTITLE_GAP_MS  = 120;
  const SUBTITLE_DURATION_MS = 600;

  words.forEach((word) => {
    word.style.transform = "translateY(100%)";
  });

  requestAnimationFrame(() => {
    requestAnimationFrame(() => {
      words.forEach((word, i) => {
        const delay = i * WORD_STAGGER_MS;
        word.style.transition = `transform ${WORD_DURATION_MS}ms cubic-bezier(0.16, 1, 0.3, 1) ${delay}ms, opacity ${WORD_DURATION_MS}ms ease ${delay}ms`;
        word.style.transform = "translateY(-10%)";
        word.style.opacity = "1";
      });

      if (subtitle) {
        const delay = words.length * WORD_STAGGER_MS + SUBTITLE_GAP_MS;
        subtitle.style.transition = `opacity ${SUBTITLE_DURATION_MS}ms ease ${delay}ms`;
        subtitle.style.opacity = "1";
      }
    });
  });
</script>
