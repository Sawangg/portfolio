---
import Bulb from "@assets/bulb.svg";
import Github from "@assets/github.svg";
import List from "@assets/list.svg";
import Rss from "@assets/rss.svg";
import Signature from "@assets/signature.svg";
import ThemeToggle from "@components/ThemeToggle.astro";
---

<header class="w-full flex-none py-6 px-4 sm:px-8 ">
  <nav class="flex items-center justify-between">
    <a href="/" class="focus:ring-1">
      <Signature class="h-9 text-black dark:text-white" title="Home" />
    </a>
    <div class="flex items-center gap-x-4 *:hover:text-black *:dark:hover:text-white md:gap-x-6">
      <a href="https://blog.leomercier.dev/" target="_blank">
        <span class="hidden md:block">Blog</span>
        <List class="size-5 md:hidden" title="Blog" />
      </a>
      <a href="/projects">
        <span class="hidden md:block">Projects</span>
        <Bulb class="size-5 md:hidden" title="Projects" />
      </a>
      <a href="https://github.com/Sawangg/" target="_blank">
        <Github class="size-5" title="Github" />
      </a>
      <a href="https://blog.leomercier.dev/rss.xml/" target="_blank">
        <Rss class="size-5" title="RSS" />
      </a>
      <ThemeToggle />
    </div>
  </nav>
</header>
