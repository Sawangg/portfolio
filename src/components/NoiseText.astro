---
interface Props {
  text: string;
  class?: string;
}

const { text, class: className } = Astro.props;
---

<span class:list={["noise-text-word relative inline-block isolate", className]} data-text={text}>
  <span class="noise-text-bg absolute bg-white pointer-events-none top-(--nt-top) left-(--nt-left) w-(--nt-width) h-(--nt-height)"></span>
  <span class="noise-text-content relative text-black z-1">{text}</span>
  <span class="noise-text-canvas-wrap absolute mix-blend-screen z-2 pointer-events-none top-(--nt-top) left-(--nt-left) w-(--nt-width) h-(--nt-height)">
    <canvas aria-hidden="true" class="block w-full h-full"></canvas>
  </span>
</span>

<script>
  const COLORS: [number, number, number][] = [
    [0x4d, 0xb8, 0xf0],  // blue       oklch(0.75 0.18 220)
    [0xc8, 0x7a, 0xf5],  // purple     oklch(0.75 0.20 310)
    [0x4d, 0xd9, 0xa5],  // green      oklch(0.75 0.16 155)
    [0xf5, 0x85, 0x75],  // red-orange oklch(0.75 0.20  25)
    [0x4d, 0xd5, 0xeb],  // cyan       oklch(0.75 0.17 195)
  ];

  function smoothNoise(x: number, y: number, t: number): number {
    return (
      Math.sin(x * 1.3 + t * 0.7) * 0.25 +
      Math.sin(y * 1.1 + t * 0.5) * 0.25 +
      Math.sin((x + y) * 0.9 + t * 0.9) * 0.25 +
      Math.sin((x - y) * 0.7 + t * 0.4) * 0.25
    );
  }

  document.querySelectorAll<HTMLElement>(".noise-text-word").forEach((wrapper) => {
    const bg = wrapper.querySelector<HTMLElement>(".noise-text-bg")!;
    const content = wrapper.querySelector<HTMLElement>(".noise-text-content")!;
    const canvasWrap = wrapper.querySelector<HTMLElement>(".noise-text-canvas-wrap")!;
    const canvas = wrapper.querySelector("canvas")!;
    const ctx = canvas.getContext("2d")!;

    let startTime = 0;

    function getTextRect(): DOMRect | null {
      const textNode = content.firstChild;
      if (!textNode || textNode.nodeType !== Node.TEXT_NODE) return null;
      const range = document.createRange();
      range.selectNode(textNode);
      return range.getBoundingClientRect();
    }

    function resize() {
      const wrapperRect = wrapper.getBoundingClientRect();
      const textRect = getTextRect();
      if (!textRect || textRect.width === 0) return;

      // Position relative to wrapper
      const top = textRect.top - wrapperRect.top;
      const left = textRect.left - wrapperRect.left;
      const width = textRect.width;
      const height = textRect.height;

      bg.style.setProperty("--nt-top", `${top}px`);
      bg.style.setProperty("--nt-left", `${left}px`);
      bg.style.setProperty("--nt-width", `${width}px`);
      bg.style.setProperty("--nt-height", `${height}px`);
      canvasWrap.style.setProperty("--nt-top", `${top}px`);
      canvasWrap.style.setProperty("--nt-left", `${left}px`);
      canvasWrap.style.setProperty("--nt-width", `${width}px`);
      canvasWrap.style.setProperty("--nt-height", `${height}px`);

      canvas.width = width;
      canvas.height = height;
    }

    function render(timestamp: number) {
      if (!startTime) startTime = timestamp;
      const t = (timestamp - startTime) / 1000;
      const w = canvas.width;
      const h = canvas.height;

      if (w === 0 || h === 0) {
        requestAnimationFrame(render);
        return;
      }

      ctx.clearRect(0, 0, w, h);

      ctx.globalCompositeOperation = "source-over";
      ctx.fillStyle = `rgb(${COLORS[0]![0]},${COLORS[0]![1]},${COLORS[0]![2]})`;
      ctx.fillRect(0, 0, w, h);

      for (let i = 0; i < COLORS.length; i++) {
        const phase = (i / COLORS.length) * Math.PI * 2;
        const speed = 0.3 + i * 0.07;
        const cx = w * (0.5 + 0.45 * Math.sin(t * speed + phase));
        const cy = h * (0.5 + 0.35 * Math.cos(t * speed * 0.7 + phase));
        const radius = w * (0.7 + 0.2 * smoothNoise(i, i * 0.5, t * 0.4));
        const [r, g, b] = COLORS[i]!;

        const grad = ctx.createRadialGradient(cx, cy, 0, cx, cy, radius);
        grad.addColorStop(0, `rgba(${r},${g},${b},1)`);
        grad.addColorStop(1, `rgba(${r},${g},${b},0)`);

        ctx.globalCompositeOperation = "source-over";
        ctx.fillStyle = grad;
        ctx.fillRect(0, 0, w, h);
      }

      requestAnimationFrame(render);
    }

    resize();
    new ResizeObserver(resize).observe(wrapper);
    requestAnimationFrame(render);
  });
</script>

