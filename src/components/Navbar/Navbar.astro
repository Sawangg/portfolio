---
import { Menu } from "./Menu";

const items = [
  {
    title: "Work",
    href: "/",
    newTab: false,
  },
  {
    title: "Resume",
    href: "/",
    newTab: false,
  },
  {
    title: "Blog",
    href: "https://leomercier.blog",
    newTab: true,
  },
];
---

<nav class="w-screen flex justify-between items-center px-6 pt-5 md:px-20 md:pt-20">
  <a href="/">Icon</a>
  <ul class="hidden gap-x-24 text-xl md:flex">
    {items.map((item) => (
      <li>
        <a href={item.href} target={item.newTab ? "_blank" : undefined}>{item.title}</a>
      </li>
    ))}
  </ul>

  <Menu iconHsl="hsl(0, 100%, 100%)" client:media="(max-width: 768px)" className="flex flex-col bg-[#1f1f1f] text-white">
    <ul class="flex flex-col text-5xl font-light gap-y-20 mt-[30vh] uppercase px-6">
    {items.map((item) => (
      <li class="opacity-0">
        <a href={item.href} target={item.newTab ? "_blank" : undefined}>{item.title}</a>
      </li>
    ))}
    </ul>
  </Menu>
</nav>
