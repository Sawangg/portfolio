{
  "dependencies": {
    "@astrojs/check": "^0.9.6",
    "@astrojs/sitemap": "^3.7.0",
    "@tailwindcss/vite": "^4.2.0",
    "astro": "^6.0.0-beta.14",
    "tailwindcss": "^4.2.0",
    "three": "^0.183.1",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.4",
    "@types/three": "^0.183.1",
    "wrangler": "^4.67.0"
  },
  "name": "portfolio26",
  "private": true,
  "scripts": {
    "biome": "biome",
    "build": "biome check && astro check && astro build",
    "check": "biome check && astro check",
    "check:fix": "biome check --fix --unsafe && astro check",
    "deploy:prod": "biome check && astro check && astro build && wrangler deploy",
    "deploy:staging": "biome check && astro check && astro build --mode staging && wrangler deploy",
    "dev": "astro dev"
  },
  "type": "module"
